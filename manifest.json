{
    "name": "TranCore",
    "version": "0.0.2",
    "description": "Auto-popup tooltip displaying translation & pronunciation of currently selected word(s)",
    "manifest_version": 3,
    "author": "Polendina",
    "content_security_policy": {
        "script-src": "self"
    },
    "content_scripts": [{
        "js": [
            "content.bundle.js"
        ],
        "run_at": "document_idle",
        "all_frames": true,
        "matches": [
            "<all_urls>"
        ]
    }],
    "background": {
        "scripts": [
            "background.bundle.js"
        ],
         "mode": "module"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage",
        "clipboardRead"
    ],
    "host_permissions": [
        "http://localhost:9999/*",
    	"https://translate.google.de/"
    ],
    "action": {
        "default_popup": "../index.html",
        "default_title": "TranCore"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "{9F5FAbc3-CD27-8Ae4-FE7c-DBF63F5dDcd2}"
      }
    }
}
