{
    "name": "TranCore",
    "version": "0.0.1",
    "description": "Auto-popup tooltip displaying translation & pronunciation of currently selected word(s)",
    "manifest_version": 3,
    "author": "Polendina",
    "content_scripts": [{
        "js": [
            "src/pages/content/index.ts"
        ],
        "run_at": "document_idle",
        "all_frames": true,
        "matches": [
            "<all_urls>"
        ]
    }],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "background": {
        "scripts": [
            "src/pages/background/index.ts"
        ]
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://kam:9999/",
    	"https://translate.google.de/"
    ],
    "action": {
        "default_popup": "src/pages/settings/index.html",
        "default_title": "TranCore"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "{9F5FAbc3-CD27-8Ae4-FE7c-DBF63F5dDcd2}"
      }
    }
}
