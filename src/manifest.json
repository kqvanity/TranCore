{
    "name": "TranCore",
    "version": "0.0.1",
    "description": "Auto-popup tooltip displaying translation & pronunciation of currently selected word(s)",
    "manifest_version": 3,
    "author": "Polendina",
    "content_security_policy": {
        "script-src": "self"
    },
    "content_scripts": [{
        "js": [
            "content.bundle.js"
        ],
        "run_at": "document_idle",
        "all_frames": true,
        "matches": [
            "<all_urls>"
        ]
    }],
    "background": {
        "scripts": [
            "background.bundle.js"
        ],
         "service_worker": "background.bundle.js",
         "mode": "module"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
    	"http://forvo.com/",
    	"https://forvo.com/",
    	"https://*.forvo.com/",
    	"https://translate.google.de/"
    ],
    "action": {
        "default_popup": "../index.html",
        "default_title": "TranCore"
    }
}
